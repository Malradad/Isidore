//@version=5
// Izzy P1 — the Teacher's own mechanical model (his 2023 class), codex/test-plan.md Priority 1.
// PDH/PDL taken in London or NY (not Asia) -> the last opposite FVG closed through with displacement -> enter at
// that close (next bar open in the tester). Stop: close back through the inverted gap (hard stop beyond the sweep
// swing; size from the hard stop). Target: next untaken internal high/low (min R). Variant B: half there, BE,
// runner to the next untaken pool (or PDH/PDL). One trade per day. Session-end flatten. Costs as v0.4.
// P2 filters (no-trade rules) and P3 time exit are inputs, off by default.
// Saved in TradingView as "Izzy P1 mechanical" (USER;a8f62b763fdc422a846624987f66b66e) v1.0.
strategy("Izzy P1 mechanical (Dodgy 2023 model)", shorttitle="Izzy P1", overlay=true,
     initial_capital=50000, currency=currency.USD,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.62,
     slippage=1, pyramiding=0, process_orders_on_close=false, calc_on_every_tick=false)
G1 = "Model"
londonS    = input.session("0200-0500", "London window (NY time)", group=G1)
nyS        = input.session("0700-1100", "NY window (NY time)", group=G1)
useLondon  = input.bool(true, "Trade London too", group=G1)
armBars    = input.int(36, "Inversion within N bars of the sweep", minval=1, group=G1)
minGapTicks = input.int(8, "Min gap (ticks)", minval=1, group=G1)
maxGapAge  = input.int(30, "Opposite FVG max age (bars)", minval=2, group=G1)
dispMin    = input.float(0.5, "Displacement: body >= x of range", step=0.05, group=G1)
pivLen     = input.int(3, "Swing strength", minval=1, group=G1)
minRR      = input.float(1.0, "Min R to the internal target", step=0.25, group=G1)
bufTicks   = input.int(2, "Hard-stop buffer (ticks)", group=G1)
variant    = input.string("A: full at internal", "Exit", options=["A: full at internal", "B: partial + runner"], group=G1)
riskUSD    = input.float(225, "Risk per trade ($)", group=G1)
maxQty     = input.int(3, "Max contracts", minval=1, group=G1)
flatSess   = input.bool(true, "Flatten at the last bar of each session", group=G1)
G2 = "P2 no-trade filters (off = pure model)"
fOvn       = input.bool(false, "a. Skip NY if overnight range (18:00-09:30) > N pts", group=G2)
ovnPts     = input.float(200, "   N (points)", group=G2)
fWin       = input.string("All", "e. NY entry window", options=["All", "0930-1030", "0930-0950"], group=G2)
fEqual     = input.bool(false, "d. No long with untaken equal lows below (short: equal highs above)", group=G2)
eqTolTicks = input.int(8, "   equal tolerance (ticks)", group=G2)
fBroad     = input.bool(false, "c. Skip after both PDH and PDL are taken (broadening)", group=G2)
G3 = "P3 management"
useTExit   = input.bool(false, "Time exit at 10:00 NY", group=G3)

tick = syminfo.mintick
pv   = syminfo.pointvalue
inSess(s) => not na(time(timeframe.period, s, "America/New_York"))
inLon = useLondon and inSess(londonS)
inNY  = inSess(nyS)
inWinBase = inLon or inNY
nyFilt = fWin == "All" ? true : fWin == "0930-1030" ? inSess("0930-1030") : inSess("0930-0950")
inWin = inLon or (inNY and nyFilt)

pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
newDay = ta.change(time("D")) != 0

// overnight range 18:00 -> 09:30
var float ovnH = na
var float ovnL = na
if newDay
    ovnH := high
    ovnL := low
else if inSess("1800-0930")
    ovnH := math.max(nz(ovnH, high), high)
    ovnL := math.min(nz(ovnL, low), low)
ovnOK = not fOvn or inLon or (ovnH - ovnL) <= ovnPts

var bool  tookH = false
var bool  tookL = false
var bool  traded = false
var int   sweepLBar = na
var int   sweepHBar = na
var float swingLow = na
var float swingHigh = na
if newDay
    tookH := false
    tookL := false
    traded := false
    sweepLBar := na
    sweepHBar := na
    swingLow := na
    swingHigh := na
if tookL and low < swingLow
    swingLow := low
if tookH and high > swingHigh
    swingHigh := high
if inWinBase and not tookL and not na(pdl) and low < pdl
    tookL := true
    sweepLBar := bar_index
    swingLow := low
if inWinBase and not tookH and not na(pdh) and high > pdh
    tookH := true
    sweepHBar := bar_index
    swingHigh := high

// untaken swing points
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
var array<float> phs = array.new_float()
var array<float> pls = array.new_float()
if not na(ph)
    array.push(phs, ph)
    if array.size(phs) > 60
        array.shift(phs)
if not na(pl)
    array.push(pls, pl)
    if array.size(pls) > 60
        array.shift(pls)
if array.size(phs) > 0
    for i = array.size(phs) - 1 to 0
        if high > array.get(phs, i)
            array.remove(phs, i)
if array.size(pls) > 0
    for i = array.size(pls) - 1 to 0
        if low < array.get(pls, i)
            array.remove(pls, i)
f_above(array<float> a, float px, float floorPx) =>
    float best = na
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            v = array.get(a, i)
            if v > px and v > floorPx and (na(best) or v < best)
                best := v
    best
f_below(array<float> a, float px, float ceilPx) =>
    float best = na
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            v = array.get(a, i)
            if v < px and v < ceilPx and (na(best) or v > best)
                best := v
    best
f_equalBelow(array<float> a, float px, float tol) =>
    bool found = false
    if array.size(a) > 1
        for i = 0 to array.size(a) - 1
            vi = array.get(a, i)
            if vi < px
                for j = 0 to array.size(a) - 1
                    if j != i and math.abs(array.get(a, j) - vi) <= tol
                        found := true
    found
f_equalAbove(array<float> a, float px, float tol) =>
    bool found = false
    if array.size(a) > 1
        for i = 0 to array.size(a) - 1
            vi = array.get(a, i)
            if vi > px
                for j = 0 to array.size(a) - 1
                    if j != i and math.abs(array.get(a, j) - vi) <= tol
                        found := true
    found

// last opposite FVG
var float bTop = na
var float bBot = na
var int   bBar = na
var float uTop = na
var float uBot = na
var int   uBar = na
if bar_index > 2 and high < low[2] and low[2] - high >= minGapTicks * tick
    bTop := low[2]
    bBot := high
    bBar := bar_index
if bar_index > 2 and low > high[2] and low - high[2] >= minGapTicks * tick
    uTop := low
    uBot := high[2]
    uBar := bar_index
rng  = high - low
disp = rng > 0 and math.abs(close - open) / rng >= dispMin
longInv  = not na(bTop) and bar_index > bBar and bar_index - bBar <= maxGapAge and close > bTop and close > open and disp
shortInv = not na(uBot) and bar_index > uBar and bar_index - uBar <= maxGapAge and close < uBot and close < open and disp
lInvBot = bBot
sInvTop = uTop
if not na(bTop) and close > bTop
    bTop := na
if not na(uBot) and close < uBot
    uBot := na

eqBelow = f_equalBelow(pls, close, eqTolTicks * tick)
eqAbove = f_equalAbove(phs, close, eqTolTicks * tick)
// signals
lSL   = swingLow - bufTicks * tick
lDist = close - lSL
lT1   = f_above(phs, close, close)
lT2r  = na(lT1) ? na : f_above(phs, lT1, lT1)
lT2   = na(lT2r) ? (not na(lT1) and pdh > lT1 ? pdh : na) : lT2r
lQty  = lDist > 0 ? math.min(math.floor(riskUSD / (lDist * pv)), maxQty) : 0
longOK = tookL and not na(sweepLBar) and bar_index - sweepLBar <= armBars and inWin and longInv and not na(lT1) and (lT1 - close) >= minRR * lDist and lQty >= 1 and ovnOK and (not fEqual or not eqBelow) and (not fBroad or not tookH)
sSL   = swingHigh + bufTicks * tick
sDist = sSL - close
sT1   = f_below(pls, close, close)
sT2r  = na(sT1) ? na : f_below(pls, sT1, sT1)
sT2   = na(sT2r) ? (not na(sT1) and pdl < sT1 ? pdl : na) : sT2r
sQty  = sDist > 0 ? math.min(math.floor(riskUSD / (sDist * pv)), maxQty) : 0
shortOK = tookH and not na(sweepHBar) and bar_index - sweepHBar <= armBars and inWin and shortInv and not na(sT1) and (close - sT1) >= minRR * sDist and sQty >= 1 and ovnOK and (not fEqual or not eqAbove) and (not fBroad or not tookL)
if longOK and shortOK
    if sweepLBar >= sweepHBar
        shortOK := false
    else
        longOK := false

var float invLvl = na
var float t2 = na
var int   qty0 = 0
lastBar = flatSess and session.islastbar
if barstate.isconfirmed
    if strategy.position_size == 0 and not traded and not lastBar
        if longOK
            strategy.entry("L", strategy.long, qty=lQty)
            if variant == "B: partial + runner" and lQty >= 2 and not na(lT2)
                h = math.floor(lQty / 2)
                strategy.exit("La", "L", qty=h, stop=lSL, limit=lT1)
                strategy.exit("Lb", "L", qty=lQty - h, stop=lSL, limit=lT2)
            else
                strategy.exit("Lx", "L", stop=lSL, limit=lT1)
            invLvl := lInvBot
            t2 := lT2
            qty0 := lQty
            traded := true
        else if shortOK
            strategy.entry("S", strategy.short, qty=sQty)
            if variant == "B: partial + runner" and sQty >= 2 and not na(sT2)
                h = math.floor(sQty / 2)
                strategy.exit("Sa", "S", qty=h, stop=sSL, limit=sT1)
                strategy.exit("Sb", "S", qty=sQty - h, stop=sSL, limit=sT2)
            else
                strategy.exit("Sx", "S", stop=sSL, limit=sT1)
            invLvl := sInvTop
            t2 := sT2
            qty0 := sQty
            traded := true
    // runner to breakeven after the partial
    if strategy.position_size > 0 and strategy.position_size < qty0
        strategy.exit("Lb", "L", stop=strategy.position_avg_price, limit=t2)
    if strategy.position_size < 0 and math.abs(strategy.position_size) < qty0
        strategy.exit("Sb", "S", stop=strategy.position_avg_price, limit=t2)
    // stop: close back through the inverted gap
    if strategy.position_size > 0 and not na(invLvl) and close < invLvl
        strategy.close_all(comment="close thru")
    if strategy.position_size < 0 and not na(invLvl) and close > invLvl
        strategy.close_all(comment="close thru")
    if useTExit and strategy.position_size != 0 and inSess("1000-1001")
        strategy.close_all(comment="10:00")
    if lastBar and strategy.position_size != 0
        strategy.close_all(comment="session end", immediately=true)
