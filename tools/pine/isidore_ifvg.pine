//@version=5
// Isidore (Izzy) — iFVG strategy v0.4.1 (v0.4.1: each alert fires once per bar — fixes duplicate fires / webhook 429s)
// v0.2 alert on every setup · v0.3 trade all hours (default on)
// v0.4 two-stage alerts (ARMED before close → CONFIRMED / CANCELLED at close),
//      alerts no longer blocked by the strategy's simulated trades or daily limits,
//      grade from 5 checks (sweep, strong volume, engineered target, momentum candle, push-through),
//      min gap 8 ticks.
// Rules come from codex/playbook.md (✓ = confirmed by the maker). Paper and backtest use only.
strategy("Isidore iFVG v0.4.1", shorttitle="Izzy iFVG", overlay=true,
     initial_capital=50000, currency=currency.USD,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.62,
     slippage=1, pyramiding=0, process_orders_on_close=false,
     calc_on_every_tick=true,
     max_labels_count=300, max_lines_count=300)

// ───────── Inputs ─────────
G1 = "Gaps"
minGapTicks = input.int(8,  "Min gap size (ticks)", minval=1, group=G1)
maxGapAge   = input.int(40, "Max gap age (bars)",   minval=3, group=G1)
maxPush     = input.int(7,  "Push-through: inversion within N bars of the gap (Dodgy: ≤ 7)", minval=1, group=G1)

G2 = "Liquidity sweep"
requireSweep = input.bool(true, "Require a liquidity sweep before the inversion", group=G2)
pivLen       = input.int(3,  "Swing strength (bars each side)", minval=1, group=G2)
sweepWindow  = input.int(15, "Inversion must come within N bars of the sweep", minval=1, group=G2)
maxSweeps    = input.int(1,  "Max sweeps in that window (1 = first sweep only)", minval=1, group=G2)

G3 = "Session and bias"
allHours   = input.bool(true, "Trade all hours (ignore trade window)", group=G3)
kzSession  = input.session("0930-1100", "Trade window (New York time)", group=G3)
flatTime   = input.session("1655-1700", "Flatten window (New York time, before CME daily break)", group=G3)
biasMode   = input.string("Both", "Manual bias", options=["Both", "Long only", "Short only"], group=G3)
useHTF     = input.bool(false, "HTF filter: close vs EMA", group=G3)
htfTF      = input.timeframe("60", "HTF timeframe", group=G3)
htfLen     = input.int(20, "HTF EMA length", group=G3)

G4 = "Stops (✓ maker)"
stopMode   = input.string("Auto (volume)", "Stop mode",
     options=["Auto (volume)", "Close back through gap", "Swing", "Inversion candle"], group=G4)
strongMult = input.float(1.5, "Strong volume ≥ x avg  → candle stop", step=0.1, group=G4)
weakMult   = input.float(1.0, "Weak volume  < x avg  → swing stop",  step=0.1, group=G4)
volLen     = input.int(20, "Volume average length", group=G4)
bufTicks   = input.int(2,  "Stop buffer (ticks)", minval=0, group=G4)

G5 = "Targets"
tgtMode    = input.string("Liquidity, fallback R", "Target mode", options=["Liquidity, fallback R", "Fixed R"], group=G5)
rr         = input.float(1.0, "R multiple (fixed / fallback)", step=0.25, minval=0.25, group=G5)
minRR      = input.float(1.0, "Min R for a liquidity target", step=0.25, group=G5)
eqTolTicks = input.int(8, "Equal highs/lows tolerance (ticks)", group=G5)
beAtR      = input.float(0.0, "Move stop to breakeven at +R (0 = off)", step=0.25, minval=0, group=G5)

G6 = "Risk (✓ maker: 1–3 MNQ, $200–250)"
riskUSD    = input.float(225, "Risk per trade ($)", group=G6)
maxQty     = input.int(3, "Max contracts", minval=1, group=G6)
momMin     = input.float(0.6, "Momentum candle: body ≥ x of range", step=0.05, group=G6)

G7 = "Backtest only (do NOT affect alerts)"
maxTrades  = input.int(3, "Max trades per day", group=G7)
maxLosses  = input.int(2, "Stop after N losses per day", group=G7)
maxDayLoss = input.float(500, "Stop after daily loss ($)", group=G7)
minScore   = input.int(1, "Min checklist score to enter (0–5)", minval=0, maxval=5, group=G7)

G8 = "Alerts"
armSec     = input.int(45, "ARMED alert: seconds before candle close (max half a candle)", minval=5, group=G8)

// ───────── Helpers ─────────
tick = syminfo.mintick
inWindow(sess) => not na(time(timeframe.period, sess, "America/New_York"))
f_b(bool x) => x ? "true" : "false"

f_nearestAbove(array<float> arr, float px) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if v > px and (na(best) or v < best)
                best := v
    best

f_nearestBelow(array<float> arr, float px) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if v < px and (na(best) or v > best)
                best := v
    best

f_countNear(array<float> arr, float lvl, float tol) =>
    int c = 0
    if array.size(arr) > 0 and not na(lvl)
        for i = 0 to array.size(arr) - 1
            if math.abs(array.get(arr, i) - lvl) <= tol
                c += 1
    c

// ───────── Swings: liquidity pools and sweeps ─────────
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
var array<float> phs = array.new_float()
var array<float> pls = array.new_float()
if not na(ph)
    array.push(phs, ph)
    if array.size(phs) > 40
        array.shift(phs)
if not na(pl)
    array.push(pls, pl)
    if array.size(pls) > 40
        array.shift(pls)

sweptLowNow = false
if array.size(pls) > 0
    for i = array.size(pls) - 1 to 0
        if low < array.get(pls, i)
            array.remove(pls, i)
            sweptLowNow := true
sweptHighNow = false
if array.size(phs) > 0
    for i = array.size(phs) - 1 to 0
        if high > array.get(phs, i)
            array.remove(phs, i)
            sweptHighNow := true

var int   sweepLowBar   = na
var float sweepLowPx    = na
var int   sweepLowCount = 0
if sweptLowNow
    sweepLowCount := not na(sweepLowBar) and bar_index - sweepLowBar <= sweepWindow ? sweepLowCount + 1 : 1
    sweepLowBar := bar_index
    sweepLowPx  := low
else if not na(sweepLowBar) and bar_index - sweepLowBar <= sweepWindow and low < sweepLowPx
    sweepLowPx := low

var int   sweepHighBar   = na
var float sweepHighPx    = na
var int   sweepHighCount = 0
if sweptHighNow
    sweepHighCount := not na(sweepHighBar) and bar_index - sweepHighBar <= sweepWindow ? sweepHighCount + 1 : 1
    sweepHighBar := bar_index
    sweepHighPx  := high
else if not na(sweepHighBar) and bar_index - sweepHighBar <= sweepWindow and high > sweepHighPx
    sweepHighPx := high

longSweepOK  = not na(sweepLowBar)  and bar_index - sweepLowBar  <= sweepWindow and sweepLowCount  <= maxSweeps
shortSweepOK = not na(sweepHighBar) and bar_index - sweepHighBar <= sweepWindow and sweepHighCount <= maxSweeps

// ───────── Fair value gaps and inversions ─────────
type FVG
    float top
    float bot
    int   dir   // 1 = bullish gap, -1 = bearish gap
    int   bar

var array<FVG> gaps = array.new<FVG>()
if bar_index > 2
    if low > high[2] and low - high[2] >= minGapTicks * tick
        array.push(gaps, FVG.new(low, high[2], 1, bar_index))
    if high < low[2] and low[2] - high >= minGapTicks * tick
        array.push(gaps, FVG.new(low[2], high, -1, bar_index))

bool  longInv  = false
bool  shortInv = false
float longGapBot = na
float shortGapTop = na
int   longAge  = na
int   shortAge = na
if array.size(gaps) > 0
    for i = array.size(gaps) - 1 to 0
        g = array.get(gaps, i)
        if bar_index - g.bar > maxGapAge
            array.remove(gaps, i)
        else if bar_index > g.bar
            if g.dir == -1 and close > g.top and close > open
                longInv := true
                longGapBot := na(longGapBot) ? g.bot : math.min(longGapBot, g.bot)
                longAge := na(longAge) ? bar_index - g.bar : math.min(longAge, bar_index - g.bar)
                array.remove(gaps, i)
            else if g.dir == 1 and close < g.bot and close < open
                shortInv := true
                shortGapTop := na(shortGapTop) ? g.top : math.max(shortGapTop, g.top)
                shortAge := na(shortAge) ? bar_index - g.bar : math.min(shortAge, bar_index - g.bar)
                array.remove(gaps, i)

// ───────── Filters ─────────
volAvg    = ta.sma(volume, volLen)
volRatio  = volAvg > 0 ? volume / volAvg : 1.0
strongVol = volRatio >= strongMult
weakVol   = volRatio < weakMult
rng       = high - low
momentum  = rng > 0 and math.abs(close - open) / rng >= momMin

htfC = request.security(syminfo.tickerid, htfTF, close[1], lookahead=barmerge.lookahead_on)
htfE = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfLen)[1], lookahead=barmerge.lookahead_on)
biasLongOK  = biasMode != "Short only" and (not useHTF or htfC > htfE)
biasShortOK = biasMode != "Long only"  and (not useHTF or htfC < htfE)

inKZ   = allHours or inWindow(kzSession)
inFlat = inWindow(flatTime)

f_mode() =>
    stopMode == "Auto (volume)" ? (strongVol ? "Inversion candle" : weakVol ? "Swing" : "Close back through gap") : stopMode

f_qty(float dist) =>
    d = dist * syminfo.pointvalue
    d > 0 ? math.min(math.floor(riskUSD / d), maxQty) : 0

f_grade(int s) => s >= 5 ? "A+" : s == 4 ? "A" : s == 3 ? "B" : "C"

// ───────── Signals (independent of the strategy's own position) ─────────
lMode  = f_mode()
lSL    = lMode == "Inversion candle" ? low - bufTicks * tick : (na(sweepLowPx) ? low : sweepLowPx) - bufTicks * tick
lDist  = close - lSL
lLiq   = f_nearestAbove(phs, close)
lEng   = f_countNear(phs, lLiq, eqTolTicks * tick) >= 2
lTP    = tgtMode == "Liquidity, fallback R" and not na(lLiq) and (lLiq - close) >= minRR * lDist ? lLiq : close + rr * lDist
lPush  = not na(longAge) and longAge <= maxPush
lScore = (longSweepOK ? 1 : 0) + (strongVol ? 1 : 0) + (lEng ? 1 : 0) + (momentum ? 1 : 0) + (lPush ? 1 : 0)
lQty   = f_qty(lDist)
longSig = longInv and inKZ and biasLongOK and (longSweepOK or not requireSweep) and lDist > 0 and lQty >= 1

sMode  = f_mode()
sSL    = sMode == "Inversion candle" ? high + bufTicks * tick : (na(sweepHighPx) ? high : sweepHighPx) + bufTicks * tick
sDist  = sSL - close
sLiq   = f_nearestBelow(pls, close)
sEng   = f_countNear(pls, sLiq, eqTolTicks * tick) >= 2
sTP    = tgtMode == "Liquidity, fallback R" and not na(sLiq) and (close - sLiq) >= minRR * sDist ? sLiq : close - rr * sDist
sPush  = not na(shortAge) and shortAge <= maxPush
sScore = (shortSweepOK ? 1 : 0) + (strongVol ? 1 : 0) + (sEng ? 1 : 0) + (momentum ? 1 : 0) + (sPush ? 1 : 0)
sQty   = f_qty(sDist)
shortSig = shortInv and inKZ and biasShortOK and (shortSweepOK or not requireSweep) and sDist > 0 and sQty >= 1

// ───────── Alerts: ARMED → CONFIRMED / CANCELLED ─────────
f_alert(string ev, string side, int score, string mode, float entry, float sl, float tp, float qty, float dist,
     bool sw, bool sv, bool eng, bool mom, bool push, float gapEdge) =>
    msg = '{"izzy":"' + ev + '","side":"' + side + '","grade":"' + f_grade(score) + '","score":' + str.tostring(score) +
         ',"symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period +
         '","entry":' + str.tostring(entry) + ',"stop":' + str.tostring(sl) + ',"target":' + str.tostring(tp) +
         ',"qty":' + str.tostring(qty) + ',"risk_pts":' + str.tostring(dist) + ',"risk_usd":' + str.tostring(qty * dist * syminfo.pointvalue) +
         ',"stop_mode":"' + mode + '","gap_edge":' + str.tostring(gapEdge) +
         ',"sweep":' + f_b(sw) + ',"strong_vol":' + f_b(sv) + ',"engineered_target":' + f_b(eng) +
         ',"momentum":' + f_b(mom) + ',"push_ok":' + f_b(push) +
         ',"bar_close":"' + str.format_time(time_close, "yyyy-MM-dd HH:mm:ss", "America/New_York") +
         '","sent":"' + str.format_time(timenow, "yyyy-MM-dd HH:mm:ss", "America/New_York") + '"}'
    alert(msg, alert.freq_all)

varip int    armedBar  = -1
varip string armedSide = ""
varip int    confBar   = -1   // bar a CONFIRMED was sent on (send once)
varip int    cancBar   = -1   // bar a CANCELLED was sent on (send once)
barMs     = time_close - time
armMs     = math.min(armSec * 1000, barMs / 2)
nearClose = barstate.isrealtime and not barstate.isconfirmed and (time_close - timenow) <= armMs

if nearClose and armedBar != bar_index
    if longSig
        f_alert("ARMED", "LONG", lScore, lMode, close, lSL, lTP, lQty, lDist, longSweepOK, strongVol, lEng, momentum, lPush, longGapBot)
        armedBar := bar_index
        armedSide := "LONG"
    else if shortSig
        f_alert("ARMED", "SHORT", sScore, sMode, close, sSL, sTP, sQty, sDist, shortSweepOK, strongVol, sEng, momentum, sPush, shortGapTop)
        armedBar := bar_index
        armedSide := "SHORT"

if barstate.isconfirmed and barstate.isrealtime and confBar != bar_index and (longSig or shortSig)
    confBar := bar_index
    if longSig
        f_alert("CONFIRMED", "LONG", lScore, lMode, close, lSL, lTP, lQty, lDist, longSweepOK, strongVol, lEng, momentum, lPush, longGapBot)
    else if shortSig
        f_alert("CONFIRMED", "SHORT", sScore, sMode, close, sSL, sTP, sQty, sDist, shortSweepOK, strongVol, sEng, momentum, sPush, shortGapTop)
if barstate.isconfirmed and barstate.isrealtime and cancBar != bar_index
    if armedBar == bar_index and not ((armedSide == "LONG" and longSig) or (armedSide == "SHORT" and shortSig))
        cancBar := bar_index
        alert('{"izzy":"CANCELLED","side":"' + armedSide + '","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period +
             '","bar_close":"' + str.format_time(time_close, "yyyy-MM-dd HH:mm:ss", "America/New_York") + '"}', alert.freq_all)

// ───────── Backtest simulation (daily limits apply here only) ─────────
newDay = ta.change(time("D")) != 0
var float dayStartNet = 0.0
var int   dayTrades = 0
var int   dayLosses = 0
var int   seenClosed = 0
if newDay
    dayStartNet := strategy.netprofit
    dayTrades := 0
    dayLosses := 0
if strategy.closedtrades > seenClosed
    for k = seenClosed to strategy.closedtrades - 1
        if strategy.closedtrades.profit(k) < 0
            dayLosses += 1
    seenClosed := strategy.closedtrades
canTrade = dayTrades < maxTrades and dayLosses < maxLosses and (strategy.netprofit - dayStartNet) > -maxDayLoss

var float tradeGap  = na
var bool  useCloseX = false
var float tradeRisk = na
var float tradeTP   = na
var float tradeSL   = na

if barstate.isconfirmed
    flat = strategy.position_size == 0
    if flat and canTrade and longSig and lScore >= minScore
        strategy.entry("L", strategy.long, qty=lQty, comment=f_grade(lScore))
        strategy.exit("L-x", "L", stop=lSL, limit=lTP)
        tradeGap := longGapBot
        useCloseX := lMode == "Close back through gap"
        tradeRisk := lDist
        tradeTP := lTP
        tradeSL := lSL
        dayTrades += 1
    else if flat and canTrade and shortSig and sScore >= minScore
        strategy.entry("S", strategy.short, qty=sQty, comment=f_grade(sScore))
        strategy.exit("S-x", "S", stop=sSL, limit=sTP)
        tradeGap := shortGapTop
        useCloseX := sMode == "Close back through gap"
        tradeRisk := sDist
        tradeTP := sTP
        tradeSL := sSL
        dayTrades += 1

    if strategy.position_size > 0
        if useCloseX and not na(tradeGap) and close < tradeGap
            strategy.close("L", comment="close thru gap")
        if beAtR > 0 and high >= strategy.position_avg_price + beAtR * tradeRisk
            strategy.exit("L-x", "L", stop=strategy.position_avg_price, limit=tradeTP)
    if strategy.position_size < 0
        if useCloseX and not na(tradeGap) and close > tradeGap
            strategy.close("S", comment="close thru gap")
        if beAtR > 0 and low <= strategy.position_avg_price - beAtR * tradeRisk
            strategy.exit("S-x", "S", stop=strategy.position_avg_price, limit=tradeTP)

    if inFlat and strategy.position_size != 0
        strategy.close_all(comment="EOD flat")

// ───────── Visuals ─────────
if barstate.isconfirmed and longSig
    label.new(bar_index, low, "LONG " + f_grade(lScore) + "\n" + lMode + "\n" + str.tostring(lQty) + " ct",
         style=label.style_label_up, color=color.new(color.teal, 10), textcolor=color.white, size=size.small)
if barstate.isconfirmed and shortSig
    label.new(bar_index, high, "SHORT " + f_grade(sScore) + "\n" + sMode + "\n" + str.tostring(sQty) + " ct",
         style=label.style_label_down, color=color.new(color.maroon, 10), textcolor=color.white, size=size.small)
plotshape(longInv  and inKZ, "Bullish inversion", shape.triangleup,   location.belowbar, color.new(color.teal, 40),   size=size.tiny)
plotshape(shortInv and inKZ, "Bearish inversion", shape.triangledown, location.abovebar, color.new(color.maroon, 40), size=size.tiny)
plot(strategy.position_size != 0 ? tradeSL : na, "Stop",   color.red,   style=plot.style_linebr)
plot(strategy.position_size != 0 ? tradeTP : na, "Target", color.green, style=plot.style_linebr)
bgcolor(not allHours and inKZ ? color.new(color.blue, 94) : na, title="Trade window")
