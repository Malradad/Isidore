//@version=5
// Isidore (Izzy) — iFVG strategy v0.2 (v0.2: alert on every setup)
// Rules come from codex/playbook.md (✓ = confirmed by the maker).
// Paper and backtest use only. Not financial advice.
strategy("Isidore iFVG v0.2", shorttitle="Izzy iFVG", overlay=true,
     initial_capital=50000, currency=currency.USD,
     default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.62,
     slippage=1, pyramiding=0, process_orders_on_close=false,
     max_labels_count=300, max_lines_count=300)

// ───────── Inputs ─────────
G1 = "Gaps"
minGapTicks = input.int(4,  "Min gap size (ticks)", minval=1, group=G1)
maxGapAge   = input.int(40, "Max gap age (bars)",   minval=3, group=G1)

G2 = "Liquidity sweep"
requireSweep = input.bool(true, "Require a liquidity sweep before the inversion", group=G2)
pivLen       = input.int(3,  "Swing strength (bars each side)", minval=1, group=G2)
sweepWindow  = input.int(15, "Inversion must come within N bars of the sweep", minval=1, group=G2)
maxSweeps    = input.int(1,  "Max sweeps in that window (1 = first sweep only)", minval=1, group=G2)

G3 = "Session and bias"
kzSession  = input.session("0930-1100", "Trade window (New York time)", group=G3)
flatTime   = input.session("1555-1600", "Flatten window (New York time)", group=G3)
biasMode   = input.string("Both", "Manual bias", options=["Both", "Long only", "Short only"], group=G3)
useHTF     = input.bool(false, "HTF filter: close vs EMA", group=G3)
htfTF      = input.timeframe("60", "HTF timeframe", group=G3)
htfLen     = input.int(20, "HTF EMA length", group=G3)

G4 = "Stops (✓ maker)"
stopMode   = input.string("Auto (volume)", "Stop mode",
     options=["Auto (volume)", "Close back through gap", "Swing", "Inversion candle"], group=G4)
strongMult = input.float(1.5, "Strong volume ≥ x avg  → candle stop", step=0.1, group=G4)
weakMult   = input.float(1.0, "Weak volume  < x avg  → swing stop",  step=0.1, group=G4)
volLen     = input.int(20, "Volume average length", group=G4)
bufTicks   = input.int(2,  "Stop buffer (ticks)", minval=0, group=G4)

G5 = "Targets"
tgtMode    = input.string("Liquidity, fallback R", "Target mode", options=["Liquidity, fallback R", "Fixed R"], group=G5)
rr         = input.float(1.0, "R multiple (fixed / fallback)", step=0.25, minval=0.25, group=G5)
minRR      = input.float(1.0, "Min R for a liquidity target", step=0.25, group=G5)
eqTolTicks = input.int(8, "Equal highs/lows tolerance (ticks)", group=G5)
beAtR      = input.float(0.0, "Move stop to breakeven at +R (0 = off)", step=0.25, minval=0, group=G5)

G6 = "Risk (✓ maker: 1–3 MNQ, $200–250)"
riskUSD    = input.float(225, "Risk per trade ($)", group=G6)
maxQty     = input.int(3, "Max contracts", minval=1, group=G6)
maxTrades  = input.int(3, "Max trades per day", group=G6)
maxLosses  = input.int(2, "Stop after N losses per day", group=G6)
maxDayLoss = input.float(500, "Stop after daily loss ($)", group=G6)
minScore   = input.int(1, "Min checklist score (0–3)", minval=0, maxval=3, group=G6)

// ───────── Helpers ─────────
tick = syminfo.mintick
inWindow(sess) => not na(time(timeframe.period, sess, "America/New_York"))

f_nearestAbove(array<float> arr, float px) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if v > px and (na(best) or v < best)
                best := v
    best

f_nearestBelow(array<float> arr, float px) =>
    float best = na
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            v = array.get(arr, i)
            if v < px and (na(best) or v > best)
                best := v
    best

f_countNear(array<float> arr, float lvl, float tol) =>
    int c = 0
    if array.size(arr) > 0 and not na(lvl)
        for i = 0 to array.size(arr) - 1
            if math.abs(array.get(arr, i) - lvl) <= tol
                c += 1
    c

// ───────── Swings: liquidity pools and sweeps ─────────
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
var array<float> phs = array.new_float()
var array<float> pls = array.new_float()
if not na(ph)
    array.push(phs, ph)
    if array.size(phs) > 40
        array.shift(phs)
if not na(pl)
    array.push(pls, pl)
    if array.size(pls) > 40
        array.shift(pls)

// A sweep = price trades through an untaken swing low/high. The level is then taken.
sweptLowNow = false
if array.size(pls) > 0
    for i = array.size(pls) - 1 to 0
        if low < array.get(pls, i)
            array.remove(pls, i)
            sweptLowNow := true
sweptHighNow = false
if array.size(phs) > 0
    for i = array.size(phs) - 1 to 0
        if high > array.get(phs, i)
            array.remove(phs, i)
            sweptHighNow := true

var int   sweepLowBar   = na
var float sweepLowPx    = na
var int   sweepLowCount = 0
if sweptLowNow
    sweepLowCount := not na(sweepLowBar) and bar_index - sweepLowBar <= sweepWindow ? sweepLowCount + 1 : 1
    sweepLowBar := bar_index
    sweepLowPx  := low
else if not na(sweepLowBar) and bar_index - sweepLowBar <= sweepWindow and low < sweepLowPx
    sweepLowPx := low

var int   sweepHighBar   = na
var float sweepHighPx    = na
var int   sweepHighCount = 0
if sweptHighNow
    sweepHighCount := not na(sweepHighBar) and bar_index - sweepHighBar <= sweepWindow ? sweepHighCount + 1 : 1
    sweepHighBar := bar_index
    sweepHighPx  := high
else if not na(sweepHighBar) and bar_index - sweepHighBar <= sweepWindow and high > sweepHighPx
    sweepHighPx := high

longSweepOK  = not na(sweepLowBar)  and bar_index - sweepLowBar  <= sweepWindow and sweepLowCount  <= maxSweeps
shortSweepOK = not na(sweepHighBar) and bar_index - sweepHighBar <= sweepWindow and sweepHighCount <= maxSweeps

// ───────── Fair value gaps and inversions ─────────
type FVG
    float top
    float bot
    int   dir   // 1 = bullish gap, -1 = bearish gap
    int   bar

var array<FVG> gaps = array.new<FVG>()
if bar_index > 2
    if low > high[2] and low - high[2] >= minGapTicks * tick
        array.push(gaps, FVG.new(low, high[2], 1, bar_index))
    if high < low[2] and low[2] - high >= minGapTicks * tick
        array.push(gaps, FVG.new(low[2], high, -1, bar_index))

bool  longInv  = false
bool  shortInv = false
float longGapBot = na
float shortGapTop = na
if array.size(gaps) > 0
    for i = array.size(gaps) - 1 to 0
        g = array.get(gaps, i)
        if bar_index - g.bar > maxGapAge
            array.remove(gaps, i)
        else if bar_index > g.bar
            // Bearish gap closed ABOVE → support → long
            if g.dir == -1 and close > g.top and close > open
                longInv := true
                longGapBot := na(longGapBot) ? g.bot : math.min(longGapBot, g.bot)
                array.remove(gaps, i)
            // Bullish gap closed BELOW → resistance → short
            else if g.dir == 1 and close < g.bot and close < open
                shortInv := true
                shortGapTop := na(shortGapTop) ? g.top : math.max(shortGapTop, g.top)
                array.remove(gaps, i)

// ───────── Filters ─────────
volAvg   = ta.sma(volume, volLen)
volRatio = volAvg > 0 ? volume / volAvg : 1.0
strongVol = volRatio >= strongMult
weakVol   = volRatio < weakMult

htfC = request.security(syminfo.tickerid, htfTF, close[1], lookahead=barmerge.lookahead_on)
htfE = request.security(syminfo.tickerid, htfTF, ta.ema(close, htfLen)[1], lookahead=barmerge.lookahead_on)
htfLongOK  = not useHTF or htfC > htfE
htfShortOK = not useHTF or htfC < htfE
biasLongOK  = biasMode != "Short only" and htfLongOK
biasShortOK = biasMode != "Long only"  and htfShortOK

inKZ   = inWindow(kzSession)
inFlat = inWindow(flatTime)

// ───────── Daily limits ─────────
newDay = ta.change(time("D")) != 0
var float dayStartNet = 0.0
var int   dayTrades = 0
var int   dayLosses = 0
var int   seenClosed = 0
if newDay
    dayStartNet := strategy.netprofit
    dayTrades := 0
    dayLosses := 0
if strategy.closedtrades > seenClosed
    for k = seenClosed to strategy.closedtrades - 1
        if strategy.closedtrades.profit(k) < 0
            dayLosses += 1
    seenClosed := strategy.closedtrades
dayPL = strategy.netprofit - dayStartNet
canTrade = dayTrades < maxTrades and dayLosses < maxLosses and dayPL > -maxDayLoss

// ───────── Trade state ─────────
var float tradeGap  = na      // gap edge for the close-back-through exit
var bool  useCloseX = false
var float tradeRisk = na
var float tradeTP   = na
var float tradeSL   = na

f_qty(float dist) =>
    d = dist * syminfo.pointvalue
    d > 0 ? math.min(math.floor(riskUSD / d), maxQty) : 0

f_mode() =>
    stopMode == "Auto (volume)" ? (strongVol ? "Inversion candle" : weakVol ? "Swing" : "Close back through gap") : stopMode

f_grade(int s) => s >= 3 ? "A+" : s == 2 ? "A" : s == 1 ? "B" : "C"

flat = strategy.position_size == 0

f_alert(string side, string grade, string mode, float entry, float sl, float tp, float qty, float dist, bool sw, bool sv, bool eng) =>
    msg = '{"izzy":"setup","side":"' + side + '","grade":"' + grade + '","symbol":"' + syminfo.ticker +
         '","tf":"' + timeframe.period + '","entry":' + str.tostring(entry) + ',"stop":' + str.tostring(sl) +
         ',"target":' + str.tostring(tp) + ',"qty":' + str.tostring(qty) + ',"risk_pts":' + str.tostring(dist) +
         ',"stop_mode":"' + mode + '","sweep":' + (sw ? "true" : "false") + ',"strong_vol":' + (sv ? "true" : "false") +
         ',"engineered_target":' + (eng ? "true" : "false") + ',"time":"' + str.format_time(time_close, "yyyy-MM-dd HH:mm:ss", "America/New_York") + '"}'
    alert(msg, alert.freq_once_per_bar_close)

// ── Long ──
if flat and longInv and inKZ and canTrade and biasLongOK and (longSweepOK or not requireSweep)
    mode = f_mode()
    swingSL  = (na(sweepLowPx) ? low : sweepLowPx) - bufTicks * tick
    candleSL = low - bufTicks * tick
    hardSL   = mode == "Inversion candle" ? candleSL : swingSL
    dist     = close - hardSL
    liq      = f_nearestAbove(phs, close)
    engineered = f_countNear(phs, liq, eqTolTicks * tick) >= 2
    tp = tgtMode == "Liquidity, fallback R" and not na(liq) and (liq - close) >= minRR * dist ? liq : close + rr * dist
    score = (longSweepOK ? 1 : 0) + (strongVol ? 1 : 0) + (engineered ? 1 : 0)
    qty = f_qty(dist)
    if dist > 0 and qty >= 1 and score >= minScore
        f_alert("LONG", f_grade(score), mode, close, hardSL, tp, qty, dist, longSweepOK, strongVol, engineered)
        strategy.entry("L", strategy.long, qty=qty, comment=f_grade(score))
        strategy.exit("L-x", "L", stop=hardSL, limit=tp)
        tradeGap := longGapBot
        useCloseX := mode == "Close back through gap"
        tradeRisk := dist
        tradeTP := tp
        tradeSL := hardSL
        dayTrades += 1
        label.new(bar_index, low, "LONG " + f_grade(score) + "\n" + mode + "\n" + str.tostring(qty) + " ct · " + str.tostring(math.round(dist / tick) * tick) + " pts",
             style=label.style_label_up, color=color.new(color.teal, 10), textcolor=color.white, size=size.small)

// ── Short ──
if flat and shortInv and inKZ and canTrade and biasShortOK and (shortSweepOK or not requireSweep)
    mode = f_mode()
    swingSL  = (na(sweepHighPx) ? high : sweepHighPx) + bufTicks * tick
    candleSL = high + bufTicks * tick
    hardSL   = mode == "Inversion candle" ? candleSL : swingSL
    dist     = hardSL - close
    liq      = f_nearestBelow(pls, close)
    engineered = f_countNear(pls, liq, eqTolTicks * tick) >= 2
    tp = tgtMode == "Liquidity, fallback R" and not na(liq) and (close - liq) >= minRR * dist ? liq : close - rr * dist
    score = (shortSweepOK ? 1 : 0) + (strongVol ? 1 : 0) + (engineered ? 1 : 0)
    qty = f_qty(dist)
    if dist > 0 and qty >= 1 and score >= minScore
        f_alert("SHORT", f_grade(score), mode, close, hardSL, tp, qty, dist, shortSweepOK, strongVol, engineered)
        strategy.entry("S", strategy.short, qty=qty, comment=f_grade(score))
        strategy.exit("S-x", "S", stop=hardSL, limit=tp)
        tradeGap := shortGapTop
        useCloseX := mode == "Close back through gap"
        tradeRisk := dist
        tradeTP := tp
        tradeSL := hardSL
        dayTrades += 1
        label.new(bar_index, high, "SHORT " + f_grade(score) + "\n" + mode + "\n" + str.tostring(qty) + " ct · " + str.tostring(math.round(dist / tick) * tick) + " pts",
             style=label.style_label_down, color=color.new(color.maroon, 10), textcolor=color.white, size=size.small)

// ───────── Managing an open trade ─────────
if strategy.position_size > 0
    // ✓ maker: exit when a candle closes back below the gap
    if useCloseX and not na(tradeGap) and close < tradeGap
        strategy.close("L", comment="close thru gap")
    if beAtR > 0 and high >= strategy.position_avg_price + beAtR * tradeRisk
        strategy.exit("L-x", "L", stop=strategy.position_avg_price, limit=tradeTP)
if strategy.position_size < 0
    if useCloseX and not na(tradeGap) and close > tradeGap
        strategy.close("S", comment="close thru gap")
    if beAtR > 0 and low <= strategy.position_avg_price - beAtR * tradeRisk
        strategy.exit("S-x", "S", stop=strategy.position_avg_price, limit=tradeTP)

if inFlat and strategy.position_size != 0
    strategy.close_all(comment="EOD flat")

// ───────── Visuals ─────────
plotshape(longInv  and inKZ, "Bullish inversion", shape.triangleup,   location.belowbar, color.new(color.teal, 40),   size=size.tiny)
plotshape(shortInv and inKZ, "Bearish inversion", shape.triangledown, location.abovebar, color.new(color.maroon, 40), size=size.tiny)
plot(strategy.position_size != 0 ? tradeSL : na, "Stop",   color.red,   style=plot.style_linebr)
plot(strategy.position_size != 0 ? tradeTP : na, "Target", color.green, style=plot.style_linebr)
bgcolor(inKZ ? color.new(color.blue, 94) : na, title="Trade window")
